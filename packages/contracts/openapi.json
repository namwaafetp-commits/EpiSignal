{
  "components": {
    "schemas": {
      "BriefPoint": {
        "additionalProperties": false,
        "description": "One bullet of a brief.\n\n`reported` is false when the article never addressed this slot. The text\nstill has to say something \u2014 it says what is missing \u2014 because an empty\nbullet and an unreported fact would look identical to a reader.",
        "properties": {
          "reported": {
            "title": "Reported",
            "type": "boolean"
          },
          "slot": {
            "$ref": "#/components/schemas/BriefSlot"
          },
          "text": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "slot",
          "text",
          "reported"
        ],
        "title": "BriefPoint",
        "type": "object"
      },
      "BriefSlot": {
        "description": "One of the five questions a brief answers, in the order it is asked.",
        "enum": [
          "what_where",
          "counts",
          "timing",
          "spread",
          "reporting"
        ],
        "title": "BriefSlot",
        "type": "string"
      },
      "Components": {
        "properties": {
          "database": {
            "enum": [
              "up",
              "down",
              "unknown"
            ],
            "title": "Database",
            "type": "string"
          },
          "postgis": {
            "enum": [
              "up",
              "down",
              "unknown"
            ],
            "title": "Postgis",
            "type": "string"
          }
        },
        "required": [
          "database",
          "postgis"
        ],
        "title": "Components",
        "type": "object"
      },
