  "info": {
    "title": "EpiSignal API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1": {
      "get": {
        "operationId": "version_api_v1_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Version",
        "tags": [
          "version"
        ]
      }
    },
    "/api/v1/admin/pipeline-runs": {
      "get": {
        "operationId": "list_pipeline_runs_api_v1_admin_pipeline_runs_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineRunListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Pipeline Runs",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/radar": {
      "get": {
        "operationId": "get_radar_api_v1_radar_get",
        "parameters": [
          {
            "in": "query",
            "name": "hours",
