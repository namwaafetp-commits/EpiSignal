# Coolify / Compose routing values. EPISIGNAL_API_HOST is used by Compose for
# Traefik's public host rule; the API service itself binds to 0.0.0.0.
EPISIGNAL_WEB_HOST=web.example.com
EPISIGNAL_API_HOST=api.example.com

# Browser-visible API URL. This value is baked into the Next.js bundle at build time.
NEXT_PUBLIC_EPISIGNAL_API_URL=https://api.example.com

# API runtime
EPISIGNAL_ENV=production
EPISIGNAL_API_PORT=8000
EPISIGNAL_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
EPISIGNAL_CORS_ORIGINS=https://web.example.com
EPISIGNAL_LOG_LEVEL=INFO

# AI providers and operator access
EPISIGNAL_OPENROUTER_API_KEY=
EPISIGNAL_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EPISIGNAL_GEMINI_API_KEY=
EPISIGNAL_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EPISIGNAL_REVIEW_ADMIN_TOKEN=

# GDELT intake
EPISIGNAL_GDELT_POLL_INTERVAL_MINUTES=15
EPISIGNAL_GDELT_QUERY_WINDOW_MINUTES=20
EPISIGNAL_GDELT_MAX_ARTICLES_PER_RUN=200
EPISIGNAL_GDELT_REQUEST_DELAY_SECONDS=5.0
EPISIGNAL_GDELT_ARTICLE_DELAY_SECONDS=1.0
EPISIGNAL_GDELT_ARTICLE_TIMEOUT_SECONDS=15.0
EPISIGNAL_GDELT_MAX_RETRIEVAL_ATTEMPTS=3
EPISIGNAL_GDELT_RETRY_BATCH_SIZE=50
EPISIGNAL_GDELT_USER_AGENT=EpiSignal/0.1 (+https://episignal.org)

# AI budgets and extraction
EPISIGNAL_AI_SIGNAL_BATCH_LIMIT=100
EPISIGNAL_AI_TRIAGE_BATCH_LIMIT=200
EPISIGNAL_AI_BATCH_SIZE=20
EPISIGNAL_AI_MAX_REQUESTS_PER_RUN=200
EPISIGNAL_AI_MAX_COST_USD_PER_RUN=0.50
EPISIGNAL_AI_MIN_CONFIDENCE=0.60
EPISIGNAL_AI_MAX_INPUT_CHARACTERS=12000
EPISIGNAL_AI_REQUEST_DELAY_SECONDS=1.0
EPISIGNAL_AI_REQUEST_TIMEOUT_SECONDS=60.0
EPISIGNAL_AI_MAX_ATTEMPTS_PER_TIER=3
EPISIGNAL_AI_MAX_TIER=3
EPISIGNAL_AI_EXTRACTION_WORKERS=8

# Stage 0 and embeddings
EPISIGNAL_STAGE0_TITLE_SIMILARITY=0.90
EPISIGNAL_STAGE0_BODY_SIMILARITY=0.80
EPISIGNAL_STAGE0_SHINGLE_SIZE=5
EPISIGNAL_STAGE0_CANDIDATE_WINDOW_HOURS=72
EPISIGNAL_STAGE0_BATCH_SIZE=200
EPISIGNAL_STAGE0_NEAR_EXACT_TITLE_SIMILARITY=92.0
EPISIGNAL_STAGE0_NEAR_EXACT_WINDOW_HOURS=48
EPISIGNAL_EMBEDDING_MODEL=BAAI/bge-m3
EPISIGNAL_EMBEDDING_PROVIDER=local
EPISIGNAL_EMBEDDING_BATCH_SIZE=16

# Geocoding
EPISIGNAL_GEOCODE_BATCH_SIZE=200
EPISIGNAL_GEOCODE_MAX_SIGNALS_PER_RUN=2000
EPISIGNAL_GAZETTEER_SOURCE=geonames-2026-08-27
EPISIGNAL_NOMINATIM_ENABLED=false
EPISIGNAL_NOMINATIM_URL=https://nominatim.openstreetmap.org
EPISIGNAL_NOMINATIM_TIMEOUT_SECONDS=10.0
EPISIGNAL_NOMINATIM_USER_AGENT=EpiSignal/0.1 (episignal backend)

# Event matching and summaries
EPISIGNAL_EVENT_CLUSTER_WINDOW_DAYS=7
EPISIGNAL_EVENT_CLUSTER_DISTANCE_KM=50.0
EPISIGNAL_EVENT_MATCH_THRESHOLD=0.60
EPISIGNAL_EVENT_MATCH_RECENCY_DAYS=90.0
EPISIGNAL_EVENT_MATCH_DISTANCE_KM=50.0
EPISIGNAL_EVENT_MATCH_BATCH_SIZE=100
EPISIGNAL_EVENT_MATCH_STALE=false
EPISIGNAL_EVENT_LOOKBACK_DAYS=7
EPISIGNAL_EVENT_CANDIDATE_LIMIT=20
EPISIGNAL_EVENT_FOLLOWUP_WINDOW_DAYS=10.0
EPISIGNAL_EVENT_MATCH_REVIEW_THRESHOLD=0.55
EPISIGNAL_EVENT_MATCH_JUDGE_BATCH_SIZE=20
EPISIGNAL_RESUMMARY_NEW_ARTICLE_COUNT=3
EPISIGNAL_RESUMMARY_MAX_AGE_HOURS=24
EPISIGNAL_SUMMARY_MAX_SOURCES=6

# Scheduler and pre-grouping
EPISIGNAL_PIPELINE_CATCH_UP_MAX_MINUTES=10080
EPISIGNAL_PIPELINE_CHAIN=daily
EPISIGNAL_PREGROUP_ENABLED=false
EPISIGNAL_PREGROUP_WINDOW_DAYS=1
EPISIGNAL_PREGROUP_EXPIRY_HOURS=72
EPISIGNAL_PREGROUP_BATCH_SIZE=200
